---
// src/components/Header.astro
import { SITE_TITLE } from '../config';
---

<header class="header">
  <div class="header-container">
    <!-- LOGO: Text-based instead of image -->
    <a href="/" class="logo">
      <span class="logo-bracket">[</span><span class="logo-text">GCS</span><span class="logo-bracket">]</span>
      <span class="logo-subtitle">GrowCloudSkills</span>
    </a>

    <!-- NAVIGATION -->
    <nav class="nav">
      <a href="/" class="nav-link">Home</a>
      <a href="/technical" class="nav-link">Technical</a>
      <a href="/functional" class="nav-link">Functional</a>
      <a href="/trainings" class="nav-link">Trainings</a>
      <a href="/about" class="nav-link">About</a>
    </nav>
  </div>
</header>

<style>
  .header {
    background: white;
    border-bottom: 1px solid #e0e0e0;
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* LOGO STYLES */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #003b66;
    font-weight: 700;
    font-size: 1.1rem;
    transition: all 0.2s;
  }

  .logo:hover {
    color: #0091b8;
  }

  .logo-bracket {
    color: #0091b8;
    font-weight: 900;
    font-size: 1.3rem;
  }

  .logo-text {
    color: #003b66;
    font-weight: 900;
    letter-spacing: 0.05em;
  }

  .logo-subtitle {
    color: #666;
    font-size: 0.9rem;
    font-weight: 500;
    margin-left: 0.5rem;
    display: none;
  }

  @media (min-width: 768px) {
    .logo-subtitle {
      display: inline;
    }
  }

  /* NAVIGATION */
  .nav {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    color: #666;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
    font-size: 0.95rem;
  }

  .nav-link:hover {
    color: #0091b8;
  }

  .nav-link:active {
    color: #003b66;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .header-container {
      padding: 0 1rem;
    }

    .nav {
      gap: 1rem;
      font-size: 0.9rem;
    }

    .nav-link {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 640px) {
    .nav {
      gap: 0.75rem;
    }

    .nav-link {
      font-size: 0.85rem;
    }

    .logo {
      font-size: 1rem;
    }
  }
</style>

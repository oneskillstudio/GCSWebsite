<style>
  .footer {
    background: #f8f9fa;
    border-top: 1px solid #e0e0e0;
    padding: 3rem 0 0 0;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem;
    display: grid;
    grid-template-columns: 1.2fr 1.5fr 1fr;
    gap: 3rem;
  }

  /* LOGO SECTION */
  .footer-logo-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #003b66;
    font-weight: 700;
    transition: color 0.2s;
    width: fit-content;
  }

  .footer-logo:hover {
    color: #0091b8;
  }

  /* LOGO BADGE */
  .logo-badge {
    background: linear-gradient(135deg, #0091b8 0%, #06b6d4 100%);
    color: white;
    padding: 0.45rem 0.75rem;
    border-radius: 6px;
    font-weight: 900;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    box-shadow: 0 2px 8px rgba(6, 182, 212, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* LOGO TEXT */
  .logo-text {
    color: #003b66;
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  /* SHORT DESCRIPTION */
  .footer-description-short {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  /* SOCIAL SECTION */
  .footer-social-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-social-section h4 {
    margin: 0;
    color: #003b66;
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .social-links-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .social-link-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    color: #666;
    text-decoration: none;
    transition: all 0.2s;
    border-radius: 6px;
    cursor: pointer;
  }

  .social-link-item:hover {
    background: #e8f2f8;
    color: #0091b8;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .social-icon svg {
    width: 100%;
    height: 100%;
  }

  .social-text {
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* NAV SECTIONS */
  .footer-nav-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-nav-section h4 {
    margin: 0;
    color: #003b66;
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-nav-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav-section a {
    color: #666;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-nav-section a:hover {
    color: #0091b8;
  }

  /* COPYRIGHT SECTION */
  .footer-copyright {
    background: white;
    border-top: 1px solid #e0e0e0;
    padding: 2rem;
    text-align: center;
    color: #666;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .footer-copyright p {
    margin: 0.5rem 0;
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-logo-section {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      padding: 2rem 1rem;
    }

    .footer {
      margin-top: 2rem;
      padding: 2rem 0 0 0;
    }

    .footer-copyright {
      padding: 1.5rem 1rem;
    }

    .logo-text {
      font-size: 1rem;
    }

    .logo-badge {
      font-size: 0.8rem;
      padding: 0.4rem 0.65rem;
    }

    .social-links-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }

    .social-link-item {
      padding: 0.5rem;
      font-size: 0.85rem;
    }

    .social-icon {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 480px) {
    .footer-container {
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .footer-nav-section ul {
      gap: 0.5rem;
    }

    .footer-nav-section h4 {
      font-size: 0.85rem;
    }

    .footer-nav-section a {
      font-size: 0.85rem;
    }

    .social-links-list {
      grid-template-columns: 1fr;
    }

    .logo-text {
      font-size: 0.95rem;
    }
  }
</style>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid #D1E0ED;
    background: #FFFFFF;
    padding-block: 3rem 2rem;
  }

  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.8fr 1.2fr;
    gap: 3rem;
    padding-bottom: 2rem;
  }

  /* ════════ BRAND SECTION ════════ */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .bio {
    color: #334155;
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
    max-width: 55ch;
    order: 1;  /* Bio first */
  }

  /* ════════ LOGO - SEPARATE LINE ════════ */
  .logo-wrapper {
    order: 2;  /* Logo second */
    display: flex;
    align-items: center;
    padding-block: 0.5rem;
  }

  .brand-link {
    display: inline-block;
  }

  .brand-logo {
    display: block;
    height: auto;
    width: 160px;           /* Proper size - adjust as needed */
    object-fit: contain;
    max-height: 80px;       /* Prevent too tall */
  }

  /* ════════ SOCIAL ICONS - SEPARATE LINE ════════ */
  .social-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: nowrap;      /* Single line always */
    order: 3;               /* Social icons last */
  }

  .social-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #E8F2F8;
    color: #0F3B66;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid #D1E0ED;
    flex-shrink: 0;
  }

  .social-icon svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  /* Icon-specific colors on hover */
  .social-icon.linkedin:hover {
    background: #0A66C2;
    color: white;
    border-color: #0A66C2;
    transform: translateY(-2px);
  }

  .social-icon.youtube:hover {
    background: #FF0000;
    color: white;
    border-color: #FF0000;
    transform: translateY(-2px);
  }

  .social-icon.twitter:hover {
    background: #000000;
    color: white;
    border-color: #000000;
    transform: translateY(-2px);
  }

  .social-icon.instagram:hover {
    background: #E1306C;
    color: white;
    border-color: #E1306C;
    transform: translateY(-2px);
  }

  .social-icon.whatsapp:hover {
    background: #25D366;
    color: white;
    border-color: #25D366;
    transform: translateY(-2px);
  }

  .social-icon.topmate:hover {
    background: #06B6D4;
    color: white;
    border-color: #06B6D4;
    transform: translateY(-2px);
  }

  /* ════════ NAVIGATION SECTION ════════ */
  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .nav-section h4 {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #0F3B66;
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-section a {
    display: block;
    font-size: 0.9rem;
    color: #334155;
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: color 0.2s ease;
  }

  .nav-section a:hover {
    color: #06B6D4;
  }

  /* ════════ LEGAL SECTION ════════ */
  .footer-legal {
    border-top: 1px solid #D1E0ED;
    padding-top: 2rem;
    margin-top: 2rem;
  }

  .footer-legal p {
    margin: 0;
    color: #64748B;
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .footer-legal p:first-child {
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .disclaimer {
    font-style: italic;
    color: #64748B;
  }

  /* ════════ RESPONSIVE ════════ */
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-nav {
      grid-template-columns: 1fr;
    }

    .site-footer {
      padding-block: 2rem 1.5rem;
    }

    .brand-logo {
      width: 140px;
    }
  }

  @media (max-width: 640px) {
    .brand-logo {
      width: 120px;
    }

    .social-links {
      gap: 0.5rem;
    }

    .social-icon {
      width: 40px;
      height: 40px;
    }

    .social-icon svg {
      width: 20px;
      height: 20px;
    }

    .bio {
      font-size: 0.88rem;
    }
  }
</style>
